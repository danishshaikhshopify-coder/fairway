# Fairway CRM — environment variable NAMES only.
# Copy to `.env.local` for local development. Never commit real values:
# `.env*` is gitignored; `.env.example` is the one exception (tracked on purpose).

# --- Supabase (Phase 2) ---
# Safe to expose to the browser (bundled into client code).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never import into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection string. Migrations and server-side tooling only.
DATABASE_URL=

# --- App ---
# Canonical URL used for absolute links / metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
